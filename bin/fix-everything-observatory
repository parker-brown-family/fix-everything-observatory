#!/usr/bin/env bash
# Fix-Everything Observatory — single entrypoint any bar widget, keybind, or
# launcher can call. The Omarchy shell plugin's chip (BarWidget.qml) runs
# `… open`; everything else is for hands and scripts.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${FIX_OBSERVATORY_PORT:-4517}"
URL="http://127.0.0.1:${PORT}/app/swarm.html"
# The mined history outlives the program. ROOT is the install and may be
# read-only; state goes where XDG puts it, and observatory.py resolves the same
# path from the same two variables so the two never disagree.
STATE="${FIX_OBSERVATORY_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/fix-everything-observatory}"
mkdir -p "$STATE"

# The horizon is a token. Unauthenticated, GitHub allows 60 requests an hour —
# three pages, two days of a repo with fifteen months of history. Authenticated
# it is 5,000, which walks the whole thing. Borrow gh's rather than ask anyone
# to paste a secret into a file; if gh has none, the miner still runs and the
# manifest records that what it saw was a slice.
if [ -z "${GITHUB_TOKEN:-}${GH_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  if tok="$(gh auth token 2>/dev/null)" && [ -n "$tok" ]; then
    export GITHUB_TOKEN="$tok"
  fi
  unset tok
fi

up() { (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null && { exec 3>&- 3<&-; return 0; } || return 1; }

ensure_server() {
  if ! up; then
    setsid -f python3 "$ROOT/observatory.py" --serve >>"$STATE/observatory.log" 2>&1
    for _ in $(seq 1 25); do up && return 0; sleep 0.15; done
    echo "server did not come up on :$PORT — see $STATE/observatory.log" >&2
    return 1
  fi
}

case "${1:-open}" in
  open)
    # An optional project slug: the bar widget's search results each open the
    # observatory pointed at their own repository, and the page reads the slug
    # straight off the query string. With none, the page lands on the built-in
    # repository rather than on whatever was last on screen.
    ensure_server
    if [ -n "${2:-}" ]; then
      exec xdg-open "${URL}?project=${2}"
    fi
    exec xdg-open "$URL" ;;
  daemon)
    # Bring the server up without putting anything on screen. The bar widget
    # calls this before it asks the server anything, because a popup that
    # answers "nothing is watched" when the truth is "nothing is running" is
    # the worst of the three states it could be in.
    ensure_server ;;
  mine)
    exec python3 "$ROOT/observatory.py" --once ;;
  projects|list)
    exec python3 "$ROOT/observatory.py" --list ;;
  scan)
    exec python3 "$ROOT/observatory.py" --scan ;;
  induct)
    [ -n "${2:-}" ] || { echo "usage: $0 induct <directory>" >&2; exit 2; }
    exec python3 "$ROOT/observatory.py" --induct "$2" ;;
  preflight|check)
    [ -n "${2:-}" ] || { echo "usage: $0 preflight <directory>" >&2; exit 2; }
    exec python3 "$ROOT/observatory.py" --preflight "$2" ;;
  seed)
    # Freeze today's manifest into the committed seed, so the next fresh clone
    # opens on a full swarm instead of a thirteen-minute empty one.
    exec python3 "$ROOT/observatory.py" --seed ;;
  serve)
    exec python3 "$ROOT/observatory.py" --serve ;;
  status)
    if up; then echo "server: up · $URL"; else echo "server: down"; fi
    echo "state:  $STATE"
    if [ -f "$STATE/manifest.json" ]; then
      tail -c 2000 "$STATE/observatory.log" 2>/dev/null | tail -n 3 || true
    elif [ -f "$ROOT/seed/manifest.js.gz" ]; then
      n=$(grep -o '"artifacts": [0-9]*' "$ROOT/seed/manifest.meta.json" 2>/dev/null | grep -o '[0-9]*' || true)
      when=$(grep -o '"fetched_at": "[0-9-]*' "$ROOT/seed/manifest.meta.json" 2>/dev/null | tail -c 11 || true)
      echo "manifest: not mined yet — serving the committed seed (${n:-?} artifacts, mined ${when:-?})"
    else
      echo "manifest: absent — run: $0 mine"
    fi ;;
  install)
    # Optional desktop entry, so app launchers can open the swarm too. The bar
    # presence itself is the Omarchy shell plugin — no extra install surface:
    #   omarchy plugin add https://github.com/parker-brown-family/fix-everything-observatory --enable
    APPS="$HOME/.local/share/applications"
    mkdir -p "$APPS"
    cat > "$APPS/fix-everything-observatory.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Fix-Everything Observatory
Comment=Watch the Omarchy repair swarm heal the repo
Exec=$ROOT/bin/fix-everything-observatory open
Icon=$ROOT/app/omarchy-logo.png
Terminal=false
Categories=Development;Monitor;
EOF
    echo "desktop entry: $APPS/fix-everything-observatory.desktop"
    echo
    echo "bar chip (if not already enabled):"
    echo "omarchy plugin enable brownfamilysports.observatory" ;;
  *)
    echo "usage: fix-everything-observatory {open [project]|daemon|mine|serve|status|install}" >&2
    echo "       fix-everything-observatory {projects|scan|preflight DIR|induct DIR}" >&2
    exit 2 ;;
esac
