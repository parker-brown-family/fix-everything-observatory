#!/usr/bin/env bash
# Fix-Everything Observatory — single entrypoint any bar widget, keybind, or
# launcher can call. The Omarchy shell plugin's chip (BarWidget.qml) runs
# `… open`; everything else is for hands and scripts.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${FIX_OBSERVATORY_PORT:-4517}"
URL="http://127.0.0.1:${PORT}/app/swarm.html"
mkdir -p "$ROOT/data"

# The horizon is a token. Unauthenticated, GitHub allows 60 requests an hour —
# three pages, two days of a repo with fifteen months of history. Authenticated
# it is 5,000, which walks the whole thing. Borrow gh's rather than ask anyone
# to paste a secret into a file; if gh has none, the miner still runs and the
# manifest records that what it saw was a slice.
if [ -z "${GITHUB_TOKEN:-}${GH_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  if tok="$(gh auth token 2>/dev/null)" && [ -n "$tok" ]; then
    export GITHUB_TOKEN="$tok"
  fi
  unset tok
fi

up() { (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null && { exec 3>&- 3<&-; return 0; } || return 1; }

ensure_server() {
  if ! up; then
    setsid -f python3 "$ROOT/observatory.py" --serve >>"$ROOT/data/observatory.log" 2>&1
    for _ in $(seq 1 25); do up && return 0; sleep 0.15; done
    echo "server did not come up on :$PORT — see $ROOT/data/observatory.log" >&2
    return 1
  fi
}

case "${1:-open}" in
  open)
    ensure_server
    exec xdg-open "$URL" ;;
  mine)
    exec python3 "$ROOT/observatory.py" --once ;;
  serve)
    exec python3 "$ROOT/observatory.py" --serve ;;
  status)
    if up; then echo "server: up · $URL"; else echo "server: down"; fi
    if [ -f "$ROOT/data/manifest.json" ]; then
      tail -c 2000 "$ROOT/data/observatory.log" 2>/dev/null | tail -n 3 || true
    else
      echo "manifest: absent — run: $0 mine"
    fi ;;
  install)
    # Optional desktop entry, so app launchers can open the swarm too. The bar
    # presence itself is the Omarchy shell plugin — no extra install surface:
    #   omarchy plugin add https://github.com/parker-brown-family/fix-everything-observatory --enable
    APPS="$HOME/.local/share/applications"
    mkdir -p "$APPS"
    cat > "$APPS/fix-everything-observatory.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Fix-Everything Observatory
Comment=Watch the Omarchy repair swarm heal the repo
Exec=$ROOT/bin/fix-everything-observatory open
Icon=$ROOT/app/omarchy-logo.png
Terminal=false
Categories=Development;Monitor;
EOF
    echo "desktop entry: $APPS/fix-everything-observatory.desktop"
    echo
    echo "bar chip (if not already enabled):"
    echo "omarchy plugin enable brownfamilysports.observatory" ;;
  *)
    echo "usage: fix-everything-observatory {open|mine|serve|status|install}" >&2
    exit 2 ;;
esac
