#!/usr/bin/env bash
# The gate. Everything that can be checked without a running Omarchy, plus
# everything that can't — skipped with a reason rather than silently.
#
#   bin/verify
#
# Exit 0 only when there are no errors AND no warnings. This runs in CI on a
# bare Ubuntu runner, which is why the split matters: a runner has Qt's QML
# tooling but no Omarchy shell, so `omarchy plugin validate` does not exist
# there. What a runner CAN do is parse the QML, read the manifest, compile the
# Python, and enforce the house rules — and those are what actually regress.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NAMESPACE="brownfamilysports"

errors=0 warns=0
err()  { printf '  \033[31m✗\033[0m %s\n' "$*"; errors=$((errors + 1)); }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; warns=$((warns + 1)); }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
skip() { printf '  \033[90m–\033[0m %s\n' "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

# Qt ships its QML tools outside PATH on some distros, so look in both places
# rather than declaring the check unavailable when it is merely elsewhere.
qt_tool() {
  local t="$1" p
  for p in "$(command -v "$t" 2>/dev/null)" "/usr/lib/qt6/bin/$t" "/usr/lib/qt6/$t"; do
    [[ -n $p && -x $p ]] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

have jq || { echo "jq is required" >&2; exit 1; }

mf="$root/manifest.json"

printf '\n\033[1mmanifest\033[0m\n'

if ! jq empty "$mf" 2>/dev/null; then
  err "manifest.json is not valid JSON"
  exit 1
fi
ok "parses"

for field in schemaVersion id name version author license description kinds entryPoints; do
  [[ "$(jq -r ".$field // empty" "$mf")" ]] || err "manifest is missing .$field"
done
ok "required fields present"

id="$(jq -r .id "$mf")"
[[ $id == "$NAMESPACE."* ]] || err "id '$id' is outside the $NAMESPACE namespace"

entry="$(jq -r '.entryPoints.barWidget // empty' "$mf")"
[[ -n $entry && -f "$root/$entry" ]] && ok "entry point $entry exists" \
  || err "entryPoints.barWidget missing or names an absent file"

[[ "$(jq -r .license "$mf")" == "MIT" && -f "$root/LICENSE" ]] \
  && ok "license: MIT declared and LICENSE file present" \
  || err "manifest .license and the LICENSE file must both say MIT"

printf '\n\033[1mqml\033[0m\n'

# `qmlformat -n` parses without resolving imports, which is the only QML check
# a machine without the Omarchy shell can actually perform — and it does catch
# a real syntax break, which is what it is here for.
if fmt="$(qt_tool qmlformat)"; then
  bad=0
  while IFS= read -r f; do
    "$fmt" -n "$f" >/dev/null 2>&1 || { err "qmlformat cannot parse ${f#"$root/"}"; bad=1; }
  done < <(find "$root" -name '*.qml' -not -path '*/.git/*')
  [[ $bad -eq 0 ]] && ok "every .qml parses"
else
  warn "qmlformat not found — QML syntax unchecked"
fi

# The bar slot comes from the ROOT's implicit size, and a root that does not set
# one is a widget that loads, enables, registers its IPC handler, passes the
# official validator, logs nothing — and draws nothing. That state is
# indistinguishable from "not installed", which is exactly how it shipped once:
# changing this file's root from BarWidget (which carried the pair) to Panel
# (a bare Item, which does not) took both lines with it, and nothing anywhere
# noticed until two sessions photographed the bar.
#
# This is a SHAPE check, not a render check — it cannot prove a chip appears,
# only that the one line whose absence guarantees it does not is present. A
# comment beside the code helps whoever is already reading it; this is for
# whoever is not. Two-space indent means a direct child of the root, which is
# the house formatting and what distinguishes it from the many nested
# `column.implicitHeight` bindings inside a panel body.
#
# The guard has its own skip branches, and the reason is this gate's whole
# argument turned on itself: a check that did not run is unmeasured, never a
# pass. Written first without them, this was the only conditional check here
# with no branch for "did not apply" — so if .kinds ever stopped declaring
# bar-widget, the check would evaporate and a reader would see a clean gate and
# count one more passing check than actually ran. Nothing in that output
# distinguished "did not apply" from "passed", which is the same collapse the
# induction battery exists to prevent.
if [[ -z ${entry:-} || ! -f "$root/$entry" ]]; then
  skip "bar-widget root sizing unchecked — there is no entry point to read (the error is above)"
elif ! jq -e '.kinds | index("bar-widget")' "$mf" >/dev/null 2>&1; then
  skip "bar-widget root sizing does not apply — .kinds no longer declares bar-widget"
else
  missing=()
  grep -qE '^  implicitWidth:' "$root/$entry"  || missing+=(implicitWidth)
  grep -qE '^  implicitHeight:' "$root/$entry" || missing+=(implicitHeight)
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "the bar-widget root sizes its own slot"
  else
    err "${entry} declares no root ${missing[*]} — the bar slot would be zero-sized and the chip would not draw, silently. Add: implicitWidth: button.implicitWidth"
  fi
fi

# The real validation needs the real validator; only an Omarchy box has it.
if have omarchy; then
  if omarchy plugin validate "$root" >/dev/null 2>&1; then
    ok "omarchy plugin validate passes"
  else
    err "omarchy plugin validate rejects this folder"
  fi
else
  skip "omarchy not installed — official validate runs on an Omarchy box"
fi

printf '\n\033[1mpython\033[0m\n'

if have python3; then
  py_bad=0
  for f in "$root"/*.py; do
    python3 -m py_compile "$f" 2>/dev/null || { err "${f#"$root/"} does not compile"; py_bad=1; }
  done
  [[ $py_bad -eq 0 ]] && ok "every python module compiles"
  # observatory.py imports induction at module scope, so a rename or a missing
  # sibling is a startup crash rather than a compile error — the glob above
  # would still pass. Import it the way the program does.
  if (cd "$root" && python3 -c 'import observatory' >/dev/null 2>&1); then
    ok "observatory imports cleanly"
  else
    err "observatory.py cannot be imported (run: python3 -c 'import observatory')"
  fi
else
  warn "python3 not found — the python modules are unchecked"
fi

printf '\n\033[1mshell\033[0m\n'

shell_scripts=("$root/bin/fix-everything-observatory" "$root/bin/render-icons.sh"
               "$root/bin/verify" "$root/bin/check-listing")
bad=0
for f in "${shell_scripts[@]}"; do
  [[ -f $f ]] || continue
  bash -n "$f" 2>/dev/null || { err "bash -n fails on ${f#"$root/"}"; bad=1; }
done
[[ $bad -eq 0 ]] && ok "every shell script parses"
# A version-manager shim with no version pinned answers `command -v` and then
# fails on every real invocation; probe with --version so that state reads as
# "not installed" instead of as findings.
if shellcheck --version >/dev/null 2>&1; then
  if shellcheck -S warning "${shell_scripts[@]}" >/dev/null 2>&1; then
    ok "shellcheck clean"
  else
    err "shellcheck has findings (run: shellcheck -S warning bin/*)"
  fi
else
  skip "shellcheck not installed"
fi

printf '\n\033[1mlisting hygiene\033[0m\n'

# The submission checklist requires installation AND removal instructions.
grep -q "omarchy plugin add" "$root/README.md" \
  && ok "README carries the install command" \
  || err "README lacks the 'omarchy plugin add' install command"
grep -q "omarchy plugin remove" "$root/README.md" \
  && ok "README carries the removal command" \
  || err "README lacks the 'omarchy plugin remove' removal command"

if [[ -f "$root/preview.png" ]]; then
  if have identify; then
    w="$(identify -format '%w' "$root/preview.png" 2>/dev/null || echo 0)"
    [[ $w -ge 1200 ]] && ok "preview.png present (${w}px wide)" \
      || err "preview.png is only ${w}px wide — the card upscales it into a blur"
  else
    ok "preview.png present (width unchecked — no imagemagick)"
  fi
else
  err "preview.png missing — the listing card falls back to nothing"
fi

if [[ -f "$root/seed/manifest.js.gz" ]]; then
  if gunzip -t "$root/seed/manifest.js.gz" 2>/dev/null; then
    ok "seed gzip is intact"
  else
    err "seed/manifest.js.gz is corrupt"
  fi
  sz="$(wc -c < "$root/seed/manifest.js.gz")"
  [[ $sz -le 3000000 ]] || warn "seed is $((sz / 1000000))MB — heavier than a clone should carry"
fi

# The observatory observes, and that is now a checked property rather than a
# promise in the README. Until v0.2.0 the ticket inspector carried a one-click
# ALLOCATE AGENT button: the server built a prompt out of the ticket's title,
# author and comments — text any stranger can write — and launched a fully
# capable `claude` on it with the operator's credentials and a writable
# checkout. A marketplace security review found it and the whole path came out.
#
# Three assertions keep it out. observatory.py is the process that reads mined
# GitHub text, so it may not be able to start anything at all. induction.py may
# still run `gh` (fixed argv, no ticket text anywhere near it), but nothing may
# reach a shell or a detached child. And no shipped surface may carry the
# endpoint, the button, or the environment flag that armed it.
if spawn_out="$(python3 "$root/tools/spawn-gate.py" 2>&1)"; then
  ok "$(printf '%s' "$spawn_out" | head -1 | sed 's/^spawn-gate: //')"
  printf '%s\n' "$spawn_out" | tail -n +2 | sed 's/^/    /'
else
  err "the spawn gate failed — a process primitive or a non-fixed argv is back"
  printf '%s\n' "$spawn_out" | sed 's/^/    /'
fi

# Scoped to every TRACKED file, not a hand-listed four: `omarchy plugin add`
# clones the repository, so a doc that advertises the removed button ships to
# every user exactly like code does. bin/verify and the gate script name these
# strings by necessity and are excluded by path, not by hoping they never match.
#
# This matched the four deleted IDENTIFIERS for one day, and passed over two
# shipped decision documents that described the button in plain English —
# "It spawns a coding agent", "The inspector's allocate button asks the local
# server to open a terminal running claude on a ticket" — in the present tense,
# in a table headed Disclosures. A reviewer greps the word, not the symbol. So
# it now matches the CLAIM: an allocation or spawn word within four words of
# "agent" or "claude", either order, joined by spaces or hyphens rather than
# punctuation. The space-only window is what keeps `spawnFx(...,agent)` and
# "without spawning git" out of the results, and both are in the tree.
#
# History is allowed to say what it said, so a line carrying an explicit
# removal marker is exempt — that is how the corrected documents keep their
# record. Tested in four directions before it landed: zero hits on the current
# tree, all ten false claims caught in the pre-fix documents, seven hostile
# rephrasings caught, and seven innocent lines from this repository clean.
alloc_re='(/api/allocate|allowAgentAllocation|FIX_OBSERVATORY_(ALLOW_AGENTS|AGENT_CMD|AGENT_CWD)'
alloc_re="$alloc_re"'|(allocat|spawn)[a-z]*([- ][a-z]+){0,4}[- ](agent|claude)'
alloc_re="$alloc_re"'|(agent|claude)([- ][a-z]+){0,4}[- ](allocat|spawn)[a-z]*'
alloc_re="$alloc_re"'|allocat[a-z]*[- ](button|endpoint))'
alloc_hits="$(git -C "$root" ls-files -z \
  | xargs -0 grep -nIiE "$alloc_re" 2>/dev/null \
  | grep -viE 'removed|no longer|superseded|was removed|are gone|goes with them' \
  | grep -vE '^(bin/verify|tools/spawn-gate\.py):' || true)"
if [[ -n "$alloc_hits" ]]; then
  err "a tracked file claims this plugin allocates or spawns an agent — that was removed under security review. Say it in the past tense, or take the line out"
  printf '%s\n' "$alloc_hits" | cut -c1-160 | sed 's/^/    /'
else
  ok "no tracked file claims an agent-allocation capability"
fi

# The README promises "network to api.github.com only", and until 0.2.0 four
# tracked pages fetched a web font from Google's CDN — which sends the reader's
# IP to a third party on every open, and is checkable by a listing reviewer in
# one devtools tab. The promise is now a check. Only fetch-shaped references
# count: a <link>, a <script src>, or a CSS @import. A documentation link to
# cli.github.com in prose is not a request and is not the concern here.
cdn_hits="$(git -C "$root" ls-files -z \
  | xargs -0 grep -nIioE '<(link|script)[^>]*(href|src)="https?://[a-z0-9.-]+|@import[^;]*url\(.?https?://[a-z0-9.-]+' 2>/dev/null \
  | grep -viE '://(www\.)?(api\.)?github\.com|://raw\.githubusercontent\.com' \
  | grep -vE '^bin/verify:' || true)"
if [[ -n "$cdn_hits" ]]; then
  err "a tracked page fetches from a third-party host — the README promises api.github.com only"
  printf '%s\n' "$cdn_hits" | sed 's/^/    /'
else
  ok "no tracked page fetches from a third-party host"
fi

# `omarchy plugin add` runs a plain `git clone`, so tracked means shipped — and
# the failure mode is not a spike, it is drift. reports/ reached 2.6MB one
# reasonable-looking commit at a time, larger than the whole runtime, and it was
# caught by hand twice before anything mechanical noticed. This is the notice.
#
# The allowlist is what the plugin needs in order to run. Everything outside it
# — the offline tools, the tests, the decision records, CI — is legitimate but
# has to stay bounded. The ceiling sits deliberately close to the current figure
# so that raising it costs a line in a diff, which is where a person sees it and
# asks what got added. Per-artifact reasoning is in
# docs/decisions/0003-what-ships-in-the-plugin-clone.md.
payload_max=262144
payload_re='^(app|bin|contract|tray|seed)/|^(BarWidget\.qml|observatory\.py|induction\.py|manifest\.json|preview\.png|README\.md|LICENSE)$'
payload=0
while IFS= read -r -d '' f; do
  [[ $f =~ $payload_re ]] && continue
  payload=$(( payload + $(stat -c%s "$root/$f" 2>/dev/null || echo 0) ))
done < <(git -C "$root" ls-files -z)
payload_kb=$(( payload / 1024 ))
if (( payload > payload_max )); then
  err "${payload_kb}KB tracked outside the runtime paths, past the $(( payload_max / 1024 ))KB ceiling — all of it ships to every user on install"
elif (( payload > payload_max * 8 / 10 )); then
  warn "${payload_kb}KB tracked outside the runtime paths, within 20% of the $(( payload_max / 1024 ))KB ceiling"
else
  ok "${payload_kb}KB tracked outside the runtime paths, under the $(( payload_max / 1024 ))KB ceiling"
fi

printf '\n\033[1minterface\033[0m\n'

# The cheap half of the interface tests, and the one that catches the expensive
# bug: markup and script live in one file, so deleting a line of HTML can leave
# a live $('#id') behind — which is a TypeError at parse time and a blank
# instrument, not a cosmetic gap.
if refout="$(python3 "$root/tests/check_refs.py" 2>&1)"; then
  printf '%s\n' "$refout"
else
  printf '%s\n' "$refout"
  err "the swarm page reaches for an element that is defined nowhere in it"
fi

# The other half needs a browser, and a bare runner may not have one. Skipped
# with a reason rather than passing quietly: an interface test that silently
# does nothing is worse than none, because the green tick lies.
if [[ ${SKIP_UI_TESTS:-} == 1 ]]; then
  skip "interface tests skipped: SKIP_UI_TESTS=1"
elif ! command -v chromium >/dev/null 2>&1 \
  && ! command -v chromium-browser >/dev/null 2>&1 \
  && ! command -v google-chrome-stable >/dev/null 2>&1 \
  && ! command -v google-chrome >/dev/null 2>&1; then
  skip "interface tests skipped: no chromium on PATH (bin/test-ui runs them)"
elif uiout="$(bash "$root/bin/test-ui" 2>&1)"; then
  # Counted off the harness's own verdict lines, not off the printed rows: those
  # carry colour escapes, and grepping them returned 1 for a suite of 43.
  n_ui="$(printf '%s' "$uiout" | grep -oE 'RESULT PASS [0-9]+' | awk '{s+=$3} END{print s+0}')"
  ok "interface tests pass ($n_ui assertions)"
else
  printf '%s\n' "$uiout"
  err "interface tests failed — bin/test-ui"
fi

# House rule, machine-absolute: no AI is ever credited in this history.
if git -C "$root" log --format=%B 2>/dev/null \
   | grep -qiE 'co-authored-by:.*(claude|copilot|codex|gemini|aider)|generated with \[?claude'; then
  err "an AI-attribution trailer is in the commit history — scrub it"
else
  ok "no AI-attribution trailers in history"
fi

printf '\n'
if [[ $errors -eq 0 && $warns -eq 0 ]]; then
  printf '\033[32mgate: clean\033[0m\n'
  exit 0
fi
printf '\033[31mgate: %d error(s), %d warning(s)\033[0m\n' "$errors" "$warns"
exit 1
