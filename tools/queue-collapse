# ---------------------------------------------------------------- main

def _ci_state(pr):
    """None means no checks are configured, which is not the same as no result.
    Neither is reported as a failure."""
    nodes = (pr.get("commits") or {}).get("nodes") or []
    if not nodes:
        return None
    commit = nodes[0].get("commit") or {}
    rollup = commit.get("statusCheckRollup")
    return rollup.get("state") if rollup else None


def normalise(issues, prs, settled=None):
    items = {}
    for r in (settled or {}).get("merged", []):
        items[r["number"]] = {
            "type": "pr", "settled": "merged", "settled_at": r.get("mergedAt"),
            "title": r.get("title") or "", "body": r.get("body") or "",
            "author": (r.get("author") or {}).get("login") or "?", "url": r.get("url", ""),
            "created": r["createdAt"],
            "closes": [c["number"] for c in ((r.get("closingIssuesReferences") or {}).get("nodes") or [])],
            "files": [f["path"] for f in ((r.get("files") or {}).get("nodes") or [])],
            "draft": False, "mergeable": None, "ci": None, "assoc": None, "decision": None,
            "reviews": 0, "additions": 0, "deletions": 0, "changed": 0,
        }
    for r in (settled or {}).get("closed", []):
        items[r["number"]] = {
            "type": "issue", "settled": "closed", "settled_at": r.get("closedAt"),
            "title": r.get("title") or "", "body": r.get("body") or "",
            "author": (r.get("author") or {}).get("login") or "?", "url": r.get("url", ""),
            "created": r["createdAt"], "closes": [], "files": [],
            "draft": False, "mergeable": None, "ci": None, "assoc": None, "decision": None,
            "reviews": 0, "additions": 0, "deletions": 0, "changed": 0,
        }
    for r in issues:
        items[r["number"]] = {
            "type": "issue", "settled": None,
            "title": r.get("title") or "", "body": r.get("body") or "",
            "author": (r.get("author") or {}).get("login") or "?", "url": r.get("url", ""),
            "created": r["createdAt"], "closes": [], "files": [],
            "draft": False, "mergeable": None, "ci": None, "assoc": None, "decision": None,
            "reviews": 0, "additions": 0, "deletions": 0, "changed": 0,
        }
    for r in prs:
        items[r["number"]] = {
            "type": "pr", "settled": None,
            "title": r.get("title") or "", "body": r.get("body") or "",
            "author": (r.get("author") or {}).get("login") or "?", "url": r.get("url", ""),
            "created": r["createdAt"],
            "closes": [c["number"] for c in ((r.get("closingIssuesReferences") or {}).get("nodes") or [])],
            "files": [f["path"] for f in ((r.get("files") or {}).get("nodes") or [])],
            "draft": r.get("isDraft", False), "mergeable": r.get("mergeable"),
            "ci": _ci_state(r),
            "assoc": r.get("authorAssociation"),
            "decision": r.get("reviewDecision"),
            "reviews": (r.get("reviews") or {}).get("totalCount", 0),
            "additions": r.get("additions", 0), "deletions": r.get("deletions", 0),
            "changed": r.get("changedFiles", 0),
        }
    return items


def main():
    ap = argparse.ArgumentParser(
        description="Find the distinct work hiding inside a flooded issue queue. Read-only.")
    ap.add_argument("repo", help="owner/name")
    ap.add_argument("--limit", type=int, default=1000,
                    help="items to examine per type (GitHub's search ceiling is 1000)")
    ap.add_argument("--since", type=int, default=45, metavar="DAYS",
                    help="how far back to read shipped work, to catch open items that duplicate it")
    ap.add_argument("--commands", action="store_true", help="print gh commands; runs nothing")
    ap.add_argument("--html", metavar="FILE", help="write a page")
    ap.add_argument("--json", metavar="FILE", help="write the full plan")
    ap.add_argument("--cache", metavar="FILE", help="reuse a previous fetch instead of the network")
    args = ap.parse_args()

    if args.cache and os.path.exists(args.cache):
        raw = json.loads(open(args.cache).read())
        issues, prs, coverage = raw["issues"], raw["prs"], raw["coverage"]
        settled = raw.get("settled")
        print(f"  cache: {len(issues)} issues, {len(prs)} pull requests", file=sys.stderr)
        if settled is None:      # cache predates the shipped-work comparison
            cutoff = (datetime.date.today() - datetime.timedelta(days=args.since)).isoformat()
            merged, _ = harvest(SETTLED_PR_Q, f"repo:{args.repo} is:pr is:merged merged:>={cutoff}",
                                10, f"merged since {cutoff}")
            closed, _ = harvest(SETTLED_ISSUE_Q,
                                f"repo:{args.repo} is:issue is:closed reason:completed closed:>={cutoff}",
                                10, f"closed since {cutoff}")
            settled = {"merged": merged, "closed": closed, "since": cutoff}
            coverage.update({"settled_since": cutoff, "merged_sampled": len(merged),
                             "closed_sampled": len(closed)})
            raw["settled"], raw["coverage"] = settled, coverage
            open(args.cache, "w").write(json.dumps(raw))
    else:
        print(f"reading {args.repo} …", file=sys.stderr)
        issues, prs, settled, coverage = fetch(args.repo, args.limit, args.since)
        if args.cache:
            open(args.cache, "w").write(json.dumps({"issues": issues, "prs": prs,
                                                    "settled": settled, "coverage": coverage}))

    items = normalise(issues, prs, settled)
    repo_words = set(re.findall(r"[a-z]+", args.repo.lower()))
    g = Grouper(items, repo_words)
    groups, find = g.build()
    p = plan(args.repo, items, groups, find, g.sim, g.edges, coverage)

    if args.json:
        open(args.json, "w").write(json.dumps(p, indent=1))
        print(f"wrote {args.json}", file=sys.stderr)
    if args.html:
        open(args.html, "w").write(render_html(p))
        print(f"wrote {args.html}", file=sys.stderr)
    print(render_commands(p) if args.commands else render_text(p))


if __name__ == "__main__":
    main()
