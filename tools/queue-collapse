#!/usr/bin/env python3
"""queue-collapse — find the distinct work hiding inside a flooded issue queue.

    queue-collapse OWNER/REPO                 # the worklist
    queue-collapse OWNER/REPO --commands      # the gh commands, printed, never run
    queue-collapse OWNER/REPO --html out.html # a page you can send someone
    queue-collapse OWNER/REPO --json out.json # everything, for tooling

Written for a maintainer whose queue is arriving faster than it drains, where the
expensive thing is no longer deciding — it is discovering that five people already
sent the same patch.

What it does: reads the open queue through `gh`, groups items that are the same
piece of work, and for each group names the one pull request worth reading and the
items that close when it merges.

Three rules it will not break:

  1. READ-ONLY. It never mutates anything. --commands prints commands for a human
     to read and run; nothing here pipes them anywhere.
  2. EVERY GROUP SHOWS ITS EVIDENCE. A group you disagree with should cost you
     five seconds to reject, so the reason is on the row, not in a score.
  3. UNKNOWN IS NOT ZERO. Items the sample never reached are "unexamined", never
     "unique". A pull request whose mergeability GitHub has not computed is not
     reported as conflicting.

It judges tickets, never people. There is no contributor score in here, and the
only author statistic is how many DISTINCT people reported a surface, which is a
fact about the bug rather than about them.

Requires: python3 (stdlib only) and `gh` authenticated with read access.
"""
import argparse, collections, datetime, html, json, math, os, re, shutil, subprocess, sys, time

GH = shutil.which("gh") or "gh"

# ---------------------------------------------------------------- fetching

ISSUE_Q = """
query($cursor:String,$q:String!){
 search(query:$q,type:ISSUE,first:50,after:$cursor){
  issueCount pageInfo{hasNextPage endCursor}
  nodes{... on Issue{
    number title body createdAt url
    author{login}
    labels(first:5){nodes{name}}
    comments{totalCount}
  }}}}
"""

PR_Q = """
query($cursor:String,$q:String!){
 search(query:$q,type:ISSUE,first:25,after:$cursor){
  issueCount pageInfo{hasNextPage endCursor}
  nodes{... on PullRequest{
    number title body createdAt url isDraft mergeable authorAssociation reviewDecision
    additions deletions changedFiles
    author{login}
    closingIssuesReferences(first:10){nodes{number}}
    files(first:20){nodes{path}}
    commits(last:1){nodes{commit{statusCheckRollup{state}}}}
    reviews(first:0){totalCount}
    comments{totalCount}
  }}}}
"""

SETTLED_PR_Q = """
query($cursor:String,$q:String!){
 search(query:$q,type:ISSUE,first:50,after:$cursor){
  issueCount pageInfo{hasNextPage endCursor}
  nodes{... on PullRequest{
    number title body createdAt mergedAt url
    author{login}
    files(first:20){nodes{path}}
    closingIssuesReferences(first:10){nodes{number}}
  }}}}
"""

SETTLED_ISSUE_Q = """
query($cursor:String,$q:String!){
 search(query:$q,type:ISSUE,first:50,after:$cursor){
  issueCount pageInfo{hasNextPage endCursor}
  nodes{... on Issue{
    number title body createdAt closedAt url stateReason
    author{login}
  }}}}
"""


def mergeable_batch_query(numbers):
    """Search answers UNKNOWN for mergeability because GitHub computes it lazily and
    a search never asks it to. A direct pullRequest(number:) query does, and answers
    on the first ask — measured on 30 of omarchy's unknowns, 30 resolved immediately.
    Aliases let one request carry fifty of them."""
    body = "\n".join(f"    p{n}: pullRequest(number:{n}){{ number mergeable }}" for n in numbers)
    return f"query($o:String!,$r:String!){{ repository(owner:$o,name:$r){{\n{body}\n}} }}"


def gql(query, variables, tries=3):
    args = [GH, "api", "graphql", "-f", "query=" + query]
    for k, v in variables.items():
        args += ["-f", f"{k}={v}"]
    for attempt in range(tries):
        p = subprocess.run(args, capture_output=True, text=True)
        if p.returncode == 0:
            try:
                d = json.loads(p.stdout)
            except json.JSONDecodeError:
                time.sleep(3 * (attempt + 1)); continue
            if "errors" in d:
                msg = str(d["errors"])[:150]
                print(f"    ! {msg}", file=sys.stderr)
                time.sleep(3 * (attempt + 1)); continue
            return d
        print(f"    ! {p.stderr.strip()[:150]}", file=sys.stderr)
        time.sleep(3 * (attempt + 1))
    return None


def harvest(query, q, pages, label):
    rows, cursor, total = [], None, None
    for i in range(pages):
        variables = {"q": q}
        if cursor:
            variables["cursor"] = cursor
        d = gql(query, variables)
        if not d:
            break
        s = d["data"]["search"]
        total = s["issueCount"]
        rows += [n for n in s["nodes"] if n]
        print(f"\r  {label}: {len(rows)}/{min(total, pages * 50)}", end="", file=sys.stderr, flush=True)
        if not s["pageInfo"]["hasNextPage"]:
            break
        cursor = s["pageInfo"]["endCursor"]
    print(file=sys.stderr)
    return rows, total


def fetch(repo, limit, since_days=45):
    """Return (issues, prs, settled, coverage). GitHub's search API refuses to page
    past 1000 results, so coverage records what was NOT looked at.

    `settled` is recently merged pull requests and recently closed issues. They are
    fetched because the most useful thing to tell someone drowning in a queue is not
    which open items match each other — it is which open items match something they
    already shipped.
    """
    issues, n_issues = harvest(ISSUE_Q, f"repo:{repo} is:issue is:open sort:created-desc",
                               limit // 50, "issues")
    prs, n_prs = harvest(PR_Q, f"repo:{repo} is:pr is:open sort:created-desc",
                         limit // 25, "pull requests")

    cutoff = (datetime.date.today() - datetime.timedelta(days=since_days)).isoformat()
    merged, _ = harvest(SETTLED_PR_Q, f"repo:{repo} is:pr is:merged merged:>={cutoff}",
                        10, f"merged since {cutoff}")
    closed, _ = harvest(SETTLED_ISSUE_Q,
                        f"repo:{repo} is:issue is:closed reason:completed closed:>={cutoff}",
                        10, f"closed since {cutoff}")
    settled = {"merged": merged, "closed": closed, "since": cutoff}

    unknown = [p["number"] for p in prs if p.get("mergeable") == "UNKNOWN"]
    if unknown:
        owner, name = repo.split("/", 1)
        fixed = {}
        for i in range(0, len(unknown), 50):
            chunk = unknown[i:i + 50]
            d = gql(mergeable_batch_query(chunk), {"o": owner, "r": name})
            if d:
                for v in (d["data"]["repository"] or {}).values():
                    if v and v.get("mergeable") != "UNKNOWN":
                        fixed[v["number"]] = v["mergeable"]
            print(f"\r  mergeability: {len(fixed)}/{len(unknown)} resolved",
                  end="", file=sys.stderr, flush=True)
        print(file=sys.stderr)
        for p in prs:
            if p["number"] in fixed:
                p["mergeable"] = fixed[p["number"]]

    coverage = {
        "open_issues_total": n_issues, "open_issues_sampled": len(issues),
        "open_prs_total": n_prs, "open_prs_sampled": len(prs),
        "settled_since": cutoff, "merged_sampled": len(merged), "closed_sampled": len(closed),
        "unexamined": max(0, (n_issues or 0) - len(issues)) + max(0, (n_prs or 0) - len(prs)),
    }
    return issues, prs, settled, coverage


